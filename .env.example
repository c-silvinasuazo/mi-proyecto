# Copy this file to .env and fill it in. Never commit .env or share it.

# Production (read-only checks)
SCHED_BASE_URL=https://sched.com
SCHED_EMAIL=
SCHED_USERNAME=
SCHED_PASSWORD=

# eph (checks that may create data, on an isolated environment). An eph event URL, for example
# https://demofriends.qa.eph.sched.co (QA, latest master) or https://demofriends.pr-1863.eph.sched.co (a PR),
# and a docker-cd test admin: username demofriendsadmin, password from
# https://github.com/schedorg/docker-cd#test-data (never paste it anywhere else).
EPH_BASE_URL=https://demofriends.qa.eph.sched.co
EPH_USERNAME=demofriendsadmin
EPH_PASSWORD=

# QA event used by read-only editor checks (REG-007)
QA_EVENT=qaengf6app

# dev2 payments (Stripe test mode). Writes to the production database: leave empty unless needed.
DEV2_BASE_URL=

# CFP flows on the production CFP with a qaeng event. Set to 1 to enable.
CFP_ENABLED=

# Public links of QA CFP forms on the production CFP (qaengreminders), for read-only checks
CFP_OPEN_FORM=https://cfp.sched.com/speaker/cFn9ZMs9zf
CFP_FUTURE_FORM=https://cfp.sched.com/speaker/zZdS7OA1SO
CFP_CLOSED_FORM=https://cfp.sched.com/speaker/IJdF21brVF
